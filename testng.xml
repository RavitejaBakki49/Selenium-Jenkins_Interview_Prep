<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="MySuite">

    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>

        <classes>
            <class name="execution.LoginTest"/>
            <class name="execution.PaymentTest"/>
        </classes>

    </test>

</suite>

